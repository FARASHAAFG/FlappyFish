<?xml version="1.0" encoding="UTF-8"?>
<class name="Seaweed" extends="Actor" extends-java="Actor" enable="true" strideversion="1">
    <javadoc xml:space="preserve"/>
    <imports>
        <import target="java.util.*" enable="true"/>
        <import target="greenfoot.*" enable="true"/>
    </imports>
    <implements/>
    <fields/>
    <constructors/>
    <methods>
        <method access="public" type="void" type-java="void" name="act" enable="true">
            <javadoc xml:space="preserve">Act - do whatever the Seaweed wants to do. This method is called whenever the 'Act' or 'Run' button gets pressed in the environment.</javadoc>
            <params/>
            <throws/>
            <body>
                <call expression="move()" expression-java="move()" enable="true"/>
                <call expression="eat()" expression-java="eat()" enable="true"/>
            </body>
        </method>
        <method access="public" type="void" type-java="void" name="move" enable="true">
            <javadoc xml:space="preserve"/>
            <params/>
            <throws/>
            <body>
                <call expression="setLocation(getX()-1,getY())" expression-java="setLocation(getX() - 1, getY())" enable="true"/>
                <if condition="getX()==0" condition-java="getX() == 0" enable="true">
                    <ifStatements>
                        <call expression="setLocation(600,getY())" expression-java="setLocation(600, getY())" enable="true"/>
                    </ifStatements>
                </if>
            </body>
        </method>
        <method access="public" type="void" type-java="void" name="eat" enable="true">
            <javadoc xml:space="preserve"/>
            <params/>
            <throws/>
            <body>
                <variable type="Actor" type-java="Actor" name="fish" value="getOneIntersectingObject(GoldF.class)" value-java="getOneIntersectingObject(GoldF.class)" enable="true"/>
                <if condition="fish!=null" condition-java="fish != null" enable="true">
                    <ifStatements>
                        <variable type="World" type-java="World" name="world" value="getWorld()" value-java="getWorld()" enable="true"/>
                        <call expression="world.removeObject(fish)" expression-java="world.removeObject(fish)" enable="true"/>
                        <comment xml:space="preserve">Greenfoot.playSound("gameOverArcade.mp3");</comment>
                    </ifStatements>
                </if>
            </body>
        </method>
    </methods>
</class>
